<launch>
    <node pkg="rviz" type="rviz" name="rviz" required="true" args="-d $(find xrobot_cv)/rviz/color.rviz" />
    <node name="object_detect" pkg="xrobot_cv" type="object_detect.py">
        <param name="image_topic" value="/camera/image_raw" />
    </node>
    <node name="follow_object" pkg="xrobot_cv" type="follow.py"/>
</launch>
