<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="chassis">
    <xacro:include filename="$(find xrobot_description)/urdf/wheels/xrobot_8kt_mecanum_wheel.xacro" />
    <xacro:macro name="xrobot_chassis" params="
        parent_prefix:=base_footprint
        wheelbase:=0.24
        track:=0.24
        base_mass
        base_x_size
        base_y_size
        base_z_size">
        
        <joint name="base_joint" type="fixed">
            <parent link="${parent_prefix}"/>
            <child link="base_link"/>
            <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
        </joint>

        <!-- Base link -->
        <link name="base_link">
            <visual>
                <origin xyz="0.0 0.0 0.097" rpy="${M_PI/2} 0 0" />
                <geometry>
                    <mesh filename="package://xrobot_description/meshes/bases/8kt_s.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="White"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${base_mass}"/>
                <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                        iyy="0.1" iyz="0.0"
                        izz="0.5" />
            </inertial>
        </link>

        <xacro:mecanum_wheel_right parent_prefix="base_link" wheel_prefix="left_front" reflect="1">
            <origin xyz="${wheelbase/2} ${track/2} 0" rpy="0 0 0" />
        </xacro:mecanum_wheel_right>

        <xacro:mecanum_wheel_left parent_prefix="base_link" wheel_prefix="right_front" reflect="-1">
            <origin xyz="${wheelbase/2} ${-track/2} 0" rpy="${M_PI} 0 0" />
        </xacro:mecanum_wheel_left>

        <xacro:mecanum_wheel_left parent_prefix="base_link" wheel_prefix="left_back" reflect="1">
            <origin xyz="${-wheelbase/2} ${track/2} 0" rpy="0 0 0" />
        </xacro:mecanum_wheel_left>

        <xacro:mecanum_wheel_right parent_prefix="base_link" wheel_prefix="right_back" reflect="-1">
            <origin xyz="${-wheelbase/2} ${-track/2} 0" rpy="${M_PI} 0 0" />
        </xacro:mecanum_wheel_right>

        <gazebo>


            <plugin name="mecanum_controller" filename="libgazebo_ros_planar_move.so">
                <updateRate>100.0</updateRate>
                <torque>50</torque>
                <publishTF>true</publishTF>
                <leftFrontJoint>left_front_wheel_joint</leftFrontJoint>
                <rightFrontJoint>right_front_wheel_joint</rightFrontJoint>
                <leftRearJoint>left_back_wheel_joint</leftRearJoint>
                <rightRearJoint>right_back_wheel_joint</rightRearJoint>
                <robotBaseFrame>base_footprint</robotBaseFrame>
                <commandTopic>cmd_vel</commandTopic>
                <odometryTopic>odom</odometryTopic>
                <odometryFrame>odom</odometryFrame>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
