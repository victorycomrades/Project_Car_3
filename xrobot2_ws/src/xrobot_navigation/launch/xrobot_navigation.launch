<launch>
    <!-- Arguments -->
    <arg name="model" default="$(env XROBOT_MODEL)"/>
    <arg name="map_file" default="$(find xrobot_navigation)/maps/nav.yaml"/>
    <arg name="open_rviz" default="true"/>

    <!-- XRobot -->
    <include file="$(find xrobot_driver)/launch/xrobot_remote.launch">
        <arg name="model" value="$(arg model)" />
    </include>

    <!-- Map server -->
    <node pkg="map_server" name="map_server" type="map_server" args="$(arg map_file)"/>

    <!-- AMCL -->
    <include file="$(find xrobot_navigation)/launch/amcl.launch"/>

    <!-- move_base -->
    <include file="$(find xrobot_navigation)/launch/move_base.launch">
        <arg name="model" value="$(arg model)" />
    </include>

    <!-- rviz -->
    <group if="$(arg open_rviz)"> 
        <node pkg="rviz" type="rviz" name="rviz" required="true"
            args="-d $(find xrobot_navigation)/rviz/xrobot_navigation.rviz"/>
    </group>
</launch>
