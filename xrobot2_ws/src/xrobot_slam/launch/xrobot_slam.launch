<launch>
    <!-- Arguments -->
    <arg name="model" default="$(env XROBOT_MODEL)"/>
    <arg name="slam_methods" default="gmapping" doc="slam type [gmapping, cartographer, hector, karto]"/>
    <arg name="configuration_basename" default="xrobot_lds_2d.lua"/>
    <arg name="open_rviz" default="true"/>

    <!-- XRobot -->
    <include file="$(find xrobot_driver)/launch/xrobot_remote.launch">
        <arg name="model" value="$(arg model)" />
    </include>

    <!-- SLAM: Gmapping, Cartographer, Hector, Karto, RTAB-Map -->
    <include file="$(find xrobot_slam)/launch/xrobot_$(arg slam_methods).launch">
        <arg name="model" value="$(arg model)"/>
        <arg name="configuration_basename" value="$(arg configuration_basename)"/>
    </include>

    <!-- rviz -->
    <group if="$(arg open_rviz)"> 
        <node pkg="rviz" type="rviz" name="rviz" required="true"
            args="-d $(find xrobot_slam)/rviz/xrobot_$(arg slam_methods).rviz"/>
    </group>
</launch>
