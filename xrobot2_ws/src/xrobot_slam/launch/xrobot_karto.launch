<launch>
    <!-- Arguments -->
    <arg name="model" default="$(env XROBOT_MODEL)"/>
    <arg name="configuration_basename" default="xrobot_lds_2d.lua"/>

    <!-- slam_karto -->
    <node pkg="slam_karto" type="slam_karto" name="slam_karto" output="screen">
        <rosparam command="load" file="$(find xrobot_slam)/config/karto_mapper_params.yaml" />
    </node>
</launch>