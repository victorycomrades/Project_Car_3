<launch>
    <arg name="ns" default=""/>
    <param name="use_sim_time" value="false"/>

    <!-- 启动手柄遥控节点 -->
    <node name="joy_node" pkg="joy" type="joy_node" output="screen" respawn="true">
        <param name="dev" type="string" value="/dev/input/js0" />
    </node>
    <node name="joystick" pkg="xrobot_teleop" type="joystick.py" output="screen" respawn="false">
        <param name="x_speed_scale"  value="0.3" />
        <param name="y_speed_scale"  value="0.3" />
        <param name="w_speed_scale"  value="0.5" />
        <remap from="cmd_vel" to="$(arg ns)/cmd_vel"/>
    </node>
</launch>