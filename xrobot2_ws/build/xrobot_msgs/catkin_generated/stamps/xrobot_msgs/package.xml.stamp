<?xml version="1.0"?>
<package format="2">
  <name>xrobot_msgs</name>
  <version>0.0.1</version>
  <description>
    Message and service types: custom messages and services for XRobot packages
  </description>
  <maintainer email="xrobot@todo.todo">xrobot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>std_msgs</depend>
  <build_depend>message_generation</build_depend>
  <build_export_depend>message_runtime</build_export_depend>
  <exec_depend>message_runtime</exec_depend>
</package>