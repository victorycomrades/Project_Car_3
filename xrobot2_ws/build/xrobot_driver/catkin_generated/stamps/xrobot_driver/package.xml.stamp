<?xml version="1.0"?>
<package format="2">
  <name>xrobot_driver</name>
  <version>0.1.0</version>
  <description>roslaunch scripts for starting the XRobot</description>

  <license>MIT</license>

  <maintainer email="xrobot@todo.todo">xrobot</maintainer>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>xrobot_msgs</depend>
  <exec_depend>xrobot_description</exec_depend>
  <exec_depend>xrobot_teleop</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosserial_python</exec_depend>

  <export></export>
</package>
