<launch>

  <include file="$(find robot_ctrl)/launch/robot_ctrl.launch" />
  <include file="$(find serial_comm)/launch/serial_comm.launch" />

  
    <!-- 启动手柄遥控节点 -->
    <node name="joy_node" pkg="joy" type="joy_node" output="screen" respawn="true">
        <param name="dev" type="string" value="/dev/input/js0" />
    </node>
</launch>
